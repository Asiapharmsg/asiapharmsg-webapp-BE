# Copy to .env (never commit it). All of these are read at container start.

# --- Database (Amazon RDS, SSL required) ---
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
# Long random string, e.g. `openssl rand -hex 48`. The app refuses to start without it.
JWT_SECRET_KEY=
# Google reCAPTCHA v2 SECRET key (the site key lives in the frontend build).
CAPTCHA_KEY=

# --- Outbound email (SMTP, STARTTLS on 587) ---
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_ADDR=no-reply@asiapharmsg.com
EMAIL_PWD=
# Optional display name + address; must be one the SMTP account may send as.
# Keep the outer single quotes: docker compose's env parser needs them.
EMAIL_FROM='"AsiaPharm SG Admin" <no-reply@asiapharmsg.com>'

# --- S3 uploads ---
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=asiapharmsg-product-images
# Leave the two keys empty on EC2 to use the instance role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Server ---
PORT=8000
